# Public URLs from the Neon console (safe to expose in the browser).
VITE_NEON_AUTH_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://<endpoint>.apirest.<region>.aws.neon.tech/neondb/rest/v1

# Optional: owner connection for running migrations from this machine. Never prefix with VITE_ (that would ship it to the browser).
DATABASE_URL=
